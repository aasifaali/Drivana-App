# Copy to .env and fill in. Never commit .env.

# production on the VPS; leave unset locally
NODE_ENV=
PORT=3000
HOST=127.0.0.1

# Long random string. Generate with: openssl rand -hex 32
JWT_SECRET=

# Google sign-in (customers + dashboard). Create an OAuth "Web application"
# client at https://console.cloud.google.com/apis/credentials and add your
# site (e.g. https://drivana.in and http://localhost:5173) as Authorized JavaScript origins.
GOOGLE_CLIENT_ID=

# Comma-separated Google accounts allowed into /admin
ADMIN_EMAILS=

# Where the SQLite database lives (default: ./data/drivana.db)
DB_FILE=

# OTP delivery: "console" prints codes in the server log. Add a real SMS
# provider in server/sms.js before opening to the public.
SMS_PROVIDER=console

# Local testing only: sign in without Google/SMS. Ignored when NODE_ENV=production.
DEV_LOGIN=1
