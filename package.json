{
  "name": "drivana",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Drivana — on-demand drivers for your own car",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch server/index.js & vite --config web/vite.config.js",
    "dev:server": "node --env-file-if-exists=.env --watch server/index.js",
    "dev:web": "vite --config web/vite.config.js",
    "build": "vite build --config web/vite.config.js",
    "start": "node --env-file-if-exists=.env server/index.js",
    "test": "node --test \"server/test/*.test.js\""
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.3",
    "@fastify/static": "^10.1.7",
    "fastify": "^5.12.7",
    "google-auth-library": "^11.3.1",
    "jsonwebtoken": "^9.0.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^6.1.2",
    "vite": "^8.3.5"
  }
}
